[
  {
    "key": "nextjs",
    "label": "Next.js",
    "kind": "frontend",
    "runtime": "node",
    "defaultNodeVersion": "22",
    "supportedPackageManagers": [
      "npm"
    ],
    "masterWorkflow": "frontendMaster",
    "serviceWorkflow": "nextjsService",
    "defaultBuildOutput": ".next",
    "defaultCommands": {
      "install": "npm ci",
      "lint": "npm run lint",
      "typecheck": "npx tsc --noEmit",
      "unit": "npm test -- --runInBand",
      "build": "npm run build"
    },
    "language": "TypeScript",
    "serviceTemplate": "nextjs-service-pipeline"
  },
