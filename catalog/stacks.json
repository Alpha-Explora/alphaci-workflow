  {
    "key": "dotnet",
    "label": ".NET",
    "kind": "backend",
    "runtime": "dotnet",
    "language": "C#",
    "defaultRuntimeVersion": "10.0.x",
    "supportedPackageManagers": [
      "nuget"
    ],
    "defaultBuildOutput": "bin/Release",
    "defaultCommands": {
      "install": "dotnet restore",
      "lint": "dotnet format --verify-no-changes",
      "typecheck": "dotnet build --no-restore",
      "unit": "dotnet test",
      "build": "dotnet build --configuration Release"
    },
    "serviceTemplate": "dotnet-service-pipeline",
    "repoShapes": [
      "standalone",
      "multi"
    ]
  }
